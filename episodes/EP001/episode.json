{
  "id": "EP001",
  "title": "Kenapa Upload Lambat?",
  "contentPillar": "Networking & Internet",
  "targetAudience": "Beginner",
  "language": "id-ID",
  "voice": "id-ID-ArdiNeural",
  "rate": "+15%",
  "objective": "Penonton paham bahwa kecepatan upload dan download berbeda karena sifat jaringan yang asimetris, dan tahu tiga penyebab utamanya.",
  "mainQuestion": "Kenapa upload file jauh lebih lambat daripada download file yang sama?",
  "keyTakeaway": "Upload dan download memakai jalur berbeda dengan kapasitas berbeda — bukan WiFi yang rusak.",
  "narration": [
    {
      "id": "n1",
      "scene": "SC01",
      "text": "Upload satu gigabyte, tiga puluh menit. Download file yang sama, cuma lima menit. Kenapa?"
    },
    {
      "id": "n2",
      "scene": "SC02",
      "text": "Karena internet di rumahmu itu asimetris. Jalur ke bawah lebar, jalur ke atas sempit."
    },
    {
      "id": "n3",
      "scene": "SC03",
      "text": "Pertama, bandwidth unggah. Kapasitas kirim jauh lebih kecil daripada kapasitas terima."
    },
    {
      "id": "n4",
      "scene": "SC03",
      "text": "Kedua, latency. Setiap paket harus menunggu tanda terima bolak-balik ke server."
    },
    {
      "id": "n5",
      "scene": "SC03",
      "text": "Ketiga, paket hilang di jalan. Satu hilang, seluruh antrean harus dikirim ulang."
    },
    {
      "id": "n6",
      "scene": "SC04",
      "text": "Bandingkan tiga jalur. Yang lebar mengalir lancar. Yang sempit menumpuk. Satu paket hilang, semuanya berhenti."
    },
    {
      "id": "n7",
      "scene": "SC05",
      "text": "Jadi bukan WiFi-mu yang rusak. Upload memang berbagi jalur yang lebih sempit. Kompres dulu, atau unggah saat jam sepi."
    }
  ],
